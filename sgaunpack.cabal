cabal-version:      2.4
name:               sgaunpack
version:            0.1.0.0
synopsis:           Read-only viewer/unpacker for Relic SGA archives (version 10)
description:
  Lists, inspects and extracts Relic Entertainment "Essence" SGA archives,
  version 10 (Age of Empires IV, Company of Heroes 3).
license:            MIT
build-type:         Simple


common shared
  default-language: Haskell2010
  ghc-options:      -Wall
  build-depends:
      base        >=4.16 && <5
    , array
    , binary
    , bytestring
    , text
    , zlib


library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:  Relic.SGA


executable sgaunpack
  import:           shared
  hs-source-dirs:   .
  main-is:          Main.hs
  build-depends:
      sgaunpack
    , directory
    , filepath
